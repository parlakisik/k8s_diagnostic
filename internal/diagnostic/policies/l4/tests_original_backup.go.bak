		logger.GetFrontendLogger().LogStepCompleteWithForcedFlush("Deploying combined L4 SNI policy", false, result.Message)
	}

	// Complete test with logging and forced flush
	duration := time.Since(startTime)
	hierarchy := &core.HierarchyContext{
		GroupId:    "l4-policies",
		SubgroupId: "tls-sni",
		TestId:     "combined-l4-sni",
		Phase:      "execution",
	}
	logger.GetFrontendLogger().LogL4TestComplete("combined-l4-sni", "tls-sni", testNumber, totalTests, result.Success, duration.Seconds(), hierarchy)

	return result
