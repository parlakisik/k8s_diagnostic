package l4

import (
	"context"
	"fmt"
	"strings"
	"time"

	"k8s-diagnostic/internal/diagnostic/core"
)

// Type aliases for compatibility
type TestResult = core.TestResult

// Function aliases
var ElapsedSeconds = core.ElapsedSeconds

// L4PolicySubgroups defines test subgroups for organization and concurrent execution
// Exported so it can be accessed from cmd/test.go for validation
var L4PolicySubgroups = map[string][]string{
	"port":    {"tcp-port-ingress", "tcp-port-egress", "port-range", "multiple-port"},
	"icmp":    {"icmp-type", "icmpv6-type", "mixed-icmp"},
	"tls-sni": {"basic-sni", "multi-domain-sni", "combined-l4-sni"},
}

// Map of test names to test keys (for CLI reference)
var L4PolicyTestNameToKey = map[string]string{
	"tcp-port-ingress-policy": "tcp-port-ingress",
	"tcp-port-egress-policy":  "tcp-port-egress",
	"port-range-policy":       "port-range",
	"multiple-port-policy":    "multiple-port",
	"icmp-type-policy":        "icmp-type",
	"icmpv6-type-policy":      "icmpv6-type",
	"mixed-icmp-policy":       "mixed-icmp",
	"basic-sni-policy":        "basic-sni",
	"multi-domain-sni-policy": "multi-domain-sni",
	"combined-l4-sni-policy":  "combined-l4-sni",
}

// TestTCPPortIngressPolicy tests the TCP port ingress policy
func TestTCPPortIngressPolicy(logger *core.MultiChannelLogger, t *core.Tester, ctx context.Context, reuseResources bool, verbose bool, testNumber int, totalTests int) TestResult {
	startTime := time.Now()
	var details []string

	policyName := "tcp-port-ingress-policy" // Keep as fallback
	policyPath := "cilium-policies/8-l4-policies/basic-port-policies/tcp-port-ingress-policy.yaml"

	// Extract real policy name from YAML metadata (same as L3 tests)
	if realPolicyName, err := t.ExtractPolicyNameFromFile(policyPath); err == nil {
		policyName = realPolicyName
	}

	// Ensure policy cleanup after test completion
	defer func() {
		if err := t.CleanupNetworkPolicy(ctx, policyName, policyPath); err != nil {
			logger.LogError("Failed to cleanup policy %s: %v", policyName, err)
		}
	}()

	// Start test with structured logging (suppress verbose headers in hierarchical mode)
	if verbose {
		logger.LogTestStart("TCP Port Ingress Policy Test", testNumber, totalTests, "l4-policies")
	}

	// Policy deployment - visible in both verbose and non-verbose modes (no step numbers)
	logger.LogStepName("Deploying TCP port ingress policy", "Policy file: tcp-port-ingress-policy.yaml")

	result := t.TestNetworkPolicy(
		ctx,
		policyName,
		policyPath,
		true, // Expect connectivity to succeed - policy allows traffic on specific ports
		&details,
		verbose,
		reuseResources,
	)

	// Calculate test duration for verbose reporting
	duration := time.Since(startTime)

	if result.Success {
		logger.GetFrontendLogger().LogStepCompleteWithForcedFlush("Deploying TCP port ingress policy", true, "TCP port ingress policy deployed and tested successfully")
	} else {
		// Enhanced verbose mode: Show detailed failure information using ACTUAL command history
		if verbose {
			// Get the REAL command executor used during TestNetworkPolicy
			executor := t.GetLastExecutor()
			if executor != nil {
				failurePoint := "HTTP connectivity test"
				errorDetails := core.ExtractErrorDetailsFromCommand(executor.GetCommandHistory(), "L4 port policy validation")

				enhancedResult := core.CreateEnhancedTestResult(result, executor, failurePoint, errorDetails)
				verboseOutput := core.FormatVerboseTestResultForHierarchy("tcp-port-ingress", enhancedResult, duration.Seconds(), verbose)

				logger.GetFrontendLogger().LogStepCompleteWithForcedFlush("Deploying TCP port ingress policy", false, verboseOutput)
			} else {
				logger.GetFrontendLogger().LogStepCompleteWithForcedFlush("Deploying TCP port ingress policy", false, result.Message)
			}
		} else {
			logger.GetFrontendLogger().LogStepCompleteWithForcedFlush("Deploying TCP port ingress policy", false, result.Message)
		}
	}

	// Complete test with logging and forced flush
	hierarchy := &core.HierarchyContext{
		GroupId:    "l4-policies",
		SubgroupId: "port",
		TestId:     "tcp-port-ingress",
		Phase:      "execution",
	}
	logger.GetFrontendLogger().LogL4TestComplete("tcp-port-ingress", "port", testNumber, totalTests, result.Success, duration.Seconds(), hierarchy)

	return result
}

// TestTCPPortEgressPolicy tests the TCP port egress policy
func TestTCPPortEgressPolicy(logger *core.MultiChannelLogger, t *core.Tester, ctx context.Context, reuseResources bool, verbose bool, testNumber int, totalTests int) TestResult {
	startTime := time.Now()
	var details []string

	policyName := "tcp-port-egress-policy" // Keep as fallback
	policyPath := "cilium-policies/8-l4-policies/basic-port-policies/tcp-port-egress-policy.yaml"

	// Extract real policy name from YAML metadata (same as L3 tests)
	if realPolicyName, err := t.ExtractPolicyNameFromFile(policyPath); err == nil {
		policyName = realPolicyName
	}

	// Create a completely fresh context instead of inheriting from potentially exhausted parent
	freshCtx := context.Background()
	testCtx, cancel := context.WithTimeout(freshCtx, 3*time.Minute)
	defer cancel()

	// Ensure policy cleanup after test completion - use fresh context for cleanup too
	defer func() {
		cleanupCtx, cleanupCancel := context.WithTimeout(context.Background(), 30*time.Second)
		defer cleanupCancel()
		if err := t.CleanupNetworkPolicy(cleanupCtx, policyName, policyPath); err != nil {
			logger.LogError("Failed to cleanup policy %s: %v", policyName, err)
		}
	}()

	// Start test with structured logging (suppress verbose headers in hierarchical mode)
	if verbose {
		logger.LogTestStart("TCP Port Egress Policy Test", testNumber, totalTests, "l4-policies")
	}

	// Policy deployment - visible in both verbose and non-verbose modes (no step numbers)
	logger.LogStepName("Deploying TCP port egress policy", "Policy file: tcp-port-egress-policy.yaml")

	result := t.TestNetworkPolicy(
		testCtx,
		policyName,
		policyPath,
		true, // Expect connectivity to succeed - policy allows TCP 80/443 egress + ICMP
		&details,
		verbose,
		reuseResources,
	)

	if result.Success {
		logger.GetFrontendLogger().LogStepCompleteWithForcedFlush("Deploying TCP port egress policy", true, "TCP port egress policy deployed and tested successfully")
	} else {
		logger.GetFrontendLogger().LogStepCompleteWithForcedFlush("Deploying TCP port egress policy", false, result.Message)
	}

	// Complete test with logging and forced flush
	duration := time.Since(startTime)
	hierarchy := &core.HierarchyContext{
		GroupId:    "l4-policies",
		SubgroupId: "port",
		TestId:     "tcp-port-egress",
		Phase:      "execution",
	}
	logger.GetFrontendLogger().LogL4TestComplete("tcp-port-egress", "port", testNumber, totalTests, result.Success, duration.Seconds(), hierarchy)

	return result
}

