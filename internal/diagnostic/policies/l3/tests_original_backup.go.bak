// TestPodNodeNamePolicy tests the pod node name policy
func TestPodNodeNamePolicy(logger *core.MultiChannelLogger, t *core.Tester, ctx context.Context, reuseResources bool, verbose bool, testNumber int, totalTests int) TestResult {
	startTime := time.Now()
	var details []string

	policyName := "pod-node-name-policy"
	policyPath := "cilium-policies/7-l3-policies/node-policies/pod-node-name-policy.yaml"

	// Ensure policy cleanup after test completion
	defer func() {
		if err := t.CleanupNetworkPolicy(ctx, policyName, policyPath); err != nil {
			logger.LogError("Failed to cleanup policy %s: %v", policyName, err)
		}
	}()

	// Start test with structured logging (suppress verbose headers in hierarchical mode)
	if verbose {
		logger.LogTestStart("Pod Node Name Policy Test", testNumber, totalTests, "l3-policies")
	}

	// Try to get the actual node information for debugging
	if verbose {
		nodes, err := t.GetClientset().CoreV1().Nodes().List(ctx, metav1.ListOptions{})
		if err == nil && len(nodes.Items) > 0 {
			logger.LogInfo("DEBUG - Actual node names in the cluster:")
			for i, node := range nodes.Items {
				logger.LogInfo("  Node %d: %s", i, node.Name)
				logger.LogInfo("    Labels: %v", node.Labels)
			}
		}
	}

	// Policy deployment - visible in both verbose and non-verbose modes (no step numbers)
	logger.LogStepName("Deploying pod node name policy", "Policy file: pod-node-name-policy.yaml")

	result := t.TestNetworkPolicy(
		ctx,
		policyName,
		policyPath,
		true, // Expect connectivity to succeed - policy allows traffic from client pods on NODE1 and host
		&details,
		verbose,
		reuseResources,
	)

	if result.Success {
		logger.GetFrontendLogger().LogStepCompleteWithForcedFlush("Deploying pod node name policy", true, "Pod node name policy deployed and tested successfully")
	} else {
		logger.GetFrontendLogger().LogStepCompleteWithForcedFlush("Deploying pod node name policy", false, result.Message)
	}

	// Complete test with logging and forced flush
	duration := time.Since(startTime)
	hierarchy := &core.HierarchyContext{
		GroupId:    "l3-policies",
		SubgroupId: "node",
		TestId:     "pod-node-name",
		Phase:      "execution",
	}
	logger.GetFrontendLogger().LogL3TestComplete("pod-node-name", "node", testNumber, totalTests, result.Success, duration.Seconds(), hierarchy)

	return result
}

// TestNodeCIDRPolicy tests the node CIDR policy
func TestNodeCIDRPolicy(logger *core.MultiChannelLogger, t *core.Tester, ctx context.Context, reuseResources bool, verbose bool, testNumber int, totalTests int) TestResult {
	startTime := time.Now()
	var details []string

	policyName := "node-cidr-policy"
	policyPath := "cilium-policies/7-l3-policies/node-policies/node-cidr-policy.yaml"

	// Create a completely fresh context instead of inheriting from potentially exhausted parent
	freshCtx := context.Background()
	testCtx, cancel := context.WithTimeout(freshCtx, 5*time.Minute)
	defer cancel()

	// Ensure policy cleanup after test completion - use fresh context for cleanup too
	defer func() {
		cleanupCtx, cleanupCancel := context.WithTimeout(context.Background(), 30*time.Second)
		defer cleanupCancel()
		if err := t.CleanupNetworkPolicy(cleanupCtx, policyName, policyPath); err != nil {
			logger.LogError("Failed to cleanup policy %s: %v", policyName, err)
		}
	}()

	// Start test with structured logging (suppress verbose headers in hierarchical mode)
	if verbose {
		logger.LogTestStart("Node CIDR Policy Test", testNumber, totalTests, "l3-policies")
	}

	// Add a cooling period before running this test
	if verbose {
		logger.LogInfo("Adding a 15-second cooling period before Node CIDR Policy test to avoid API rate limiting...")
	}
	time.Sleep(15 * time.Second)

	// Policy deployment - visible in both verbose and non-verbose modes (no step numbers)
	logger.LogStepName("Deploying node CIDR policy", "Policy file: node-cidr-policy.yaml")

	result := t.TestNetworkPolicy(
		testCtx, // Use fresh timeout context
		policyName,
		policyPath,
		true, // Expect connectivity to succeed - policy allows traffic from any IP
		&details,
		verbose,
		reuseResources,
	)

	// If the test failed, retry it once more with even more delay
	if !result.Success {
		if verbose {
			logger.LogInfo("Node CIDR Policy test failed on first attempt. Waiting 20 seconds and retrying...")
		}
		time.Sleep(20 * time.Second)

		// Clear details for the retry
		details = []string{}

		// Create a fresh timeout context for the retry
		retryCtx, retryCancel := context.WithTimeout(ctx, 3*time.Minute)
		defer retryCancel()

		result = t.TestNetworkPolicy(
			retryCtx,
			"node-cidr-policy",
			"cilium-policies/7-l3-policies/node-policies/node-cidr-policy.yaml",
			true,
			&details,
			verbose,
			reuseResources,
		)
	}

	if result.Success {
		logger.GetFrontendLogger().LogStepCompleteWithForcedFlush("Deploying node CIDR policy", true, "Node CIDR policy deployed and tested successfully")
	} else {
		logger.GetFrontendLogger().LogStepCompleteWithForcedFlush("Deploying node CIDR policy", false, result.Message)
	}

	// Complete test with logging and forced flush
	duration := time.Since(startTime)
	hierarchy := &core.HierarchyContext{
		GroupId:    "l3-policies",
		SubgroupId: "node",
		TestId:     "node-cidr",
		Phase:      "execution",
	}
	logger.GetFrontendLogger().LogL3TestComplete("node-cidr", "node", testNumber, totalTests, result.Success, duration.Seconds(), hierarchy)

	return result
}

// TestNodeBasedPolicy tests the node based policy clusterwide
func TestNodeBasedPolicy(logger *core.MultiChannelLogger, t *core.Tester, ctx context.Context, reuseResources bool, verbose bool, testNumber int, totalTests int) TestResult {
	startTime := time.Now()
	var details []string

	policyName := "node-based-policy-clusterwide"
	policyPath := "cilium-policies/7-l3-policies/node-policies/node-based-policy-clusterwide.yaml"

	// Create a completely fresh context instead of inheriting from potentially exhausted parent
	freshCtx := context.Background()
	testCtx, cancel := context.WithTimeout(freshCtx, 3*time.Minute)
	defer cancel()

	// Ensure policy cleanup after test completion - use fresh context for cleanup too
	defer func() {
		cleanupCtx, cleanupCancel := context.WithTimeout(context.Background(), 30*time.Second)
		defer cleanupCancel()
		if err := t.CleanupNetworkPolicy(cleanupCtx, policyName, policyPath); err != nil {
			logger.LogError("Failed to cleanup policy %s: %v", policyName, err)
		}
	}()

	// Start test with structured logging (suppress verbose headers in hierarchical mode)
	if verbose {
		logger.LogTestStart("Node Based Policy Test", testNumber, totalTests, "l3-policies")
	}

	// Try to get the actual node information for debugging
	if verbose {
		nodes, err := t.GetClientset().CoreV1().Nodes().List(ctx, metav1.ListOptions{})
		if err == nil && len(nodes.Items) > 0 {
			logger.LogInfo("DEBUG - Actual node names in the cluster:")
			for i, node := range nodes.Items {
				logger.LogInfo("  Node %d: %s", i, node.Name)
				logger.LogInfo("    Labels: %v", node.Labels)
			}
		}
	}

	// Add cooling period to avoid API rate limiting
	time.Sleep(5 * time.Second)

	// Policy deployment - visible in both verbose and non-verbose modes (no step numbers)
	logger.LogStepName("Deploying node based policy", "Policy file: node-based-policy-clusterwide.yaml")

	result := t.TestNetworkPolicy(
		testCtx, // Use fresh timeout context
		policyName,
		policyPath,
		true, // Expect connectivity to succeed - policy allows traffic from any node
		&details,
		verbose,
		reuseResources,
	)

	if result.Success {
		logger.GetFrontendLogger().LogStepCompleteWithForcedFlush("Deploying node based policy", true, "Node based policy deployed and tested successfully")
	} else {
		logger.GetFrontendLogger().LogStepCompleteWithForcedFlush("Deploying node based policy", false, result.Message)
	}

	// Complete test with logging and forced flush
	duration := time.Since(startTime)
	hierarchy := &core.HierarchyContext{
		GroupId:    "l3-policies",
		SubgroupId: "node",
		TestId:     "node-based",
		Phase:      "execution",
	}
	logger.GetFrontendLogger().LogL3TestComplete("node-based", "node", testNumber, totalTests, result.Success, duration.Seconds(), hierarchy)

	return result
}

// TestKubernetesServicePolicy tests the Kubernetes service policy
func TestKubernetesServicePolicy(logger *core.MultiChannelLogger, t *core.Tester, ctx context.Context, reuseResources bool, verbose bool, testNumber int, totalTests int) TestResult {
	startTime := time.Now()
	var details []string

	policyName := "service-based-policy"
	policyPath := "cilium-policies/7-l3-policies/services-policies/kubernetes-service-policy.yaml"

	// Create a completely fresh context instead of inheriting from potentially exhausted parent
	freshCtx := context.Background()
	testCtx, cancel := context.WithTimeout(freshCtx, 3*time.Minute)
	defer cancel()

	// Ensure policy cleanup after test completion - use fresh context for cleanup too
	defer func() {
		cleanupCtx, cleanupCancel := context.WithTimeout(context.Background(), 30*time.Second)
		defer cleanupCancel()
		if err := t.CleanupNetworkPolicy(cleanupCtx, policyName, policyPath); err != nil {
			logger.LogError("Failed to cleanup policy %s: %v", policyName, err)
		}
	}()

	// Start test with structured logging (suppress verbose headers in hierarchical mode)
	if verbose {
		logger.LogTestStart("Kubernetes Service Policy Test", testNumber, totalTests, "l3-policies")
	}

	// Policy deployment - visible in both verbose and non-verbose modes (no step numbers)
	logger.LogStepName("Deploying Kubernetes service policy", "Policy file: kubernetes-service-policy.yaml")

	result := t.TestNetworkPolicy(
		testCtx, // Use fresh timeout context
		policyName,
		policyPath,
		true, // Expect connectivity to succeed - policy allows traffic from k8s services
		&details,
		verbose,
		reuseResources,
	)

	if result.Success {
		logger.GetFrontendLogger().LogStepCompleteWithForcedFlush("Deploying Kubernetes service policy", true, "Kubernetes service policy deployed and tested successfully")
	} else {
		logger.GetFrontendLogger().LogStepCompleteWithForcedFlush("Deploying Kubernetes service policy", false, result.Message)
	}

	// Complete test with logging and forced flush
	duration := time.Since(startTime)
	hierarchy := &core.HierarchyContext{
		GroupId:    "l3-policies",
		SubgroupId: "service",
		TestId:     "kubernetes-service",
		Phase:      "execution",
	}
	logger.GetFrontendLogger().LogL3TestComplete("kubernetes-service", "service", testNumber, totalTests, result.Success, duration.Seconds(), hierarchy)

	return result
}

// L3TestGroup represents a group of L3 tests with metadata for the executor
type L3TestGroup struct {
	Name      string
	TestFuncs []func(*core.MultiChannelLogger, *core.Tester, context.Context, bool, bool, int, int) TestResult
	TestNames []string
}

// TestL3PoliciesSequential runs L3 policy tests with sequential execution for clean policy isolation
func TestL3PoliciesSequential(t *core.Tester, ctx context.Context, requestedSubgroups []string, verbose ...bool) []TestResult {
	// Determine verbose mode
	isVerbose := false
	if len(verbose) > 0 {
		isVerbose = verbose[0]
	}
	allResults := []TestResult{}

	if isVerbose {
		fmt.Printf("\n===== L3 POLICIES SEQUENTIAL EXECUTION - VERBOSE MODE ENABLED =====\n")
		fmt.Printf("Verbose output will be shown for each test\n")
		fmt.Printf("============================================================\n\n")
	}

	// Get global logger for L3-specific logging with forced flush
	logger := core.GetGlobalMultiChannelLogger()
	if logger == nil {
		fmt.Printf("ERROR: Failed to get global multi-channel logger for L3 pre-cleanup\n")
		return allResults
	}

	// Record overall start time
	overallStart := time.Now()

	// Connectivity verification (placeholder for now)
	logger.GetFrontendLogger().LogStepCompleteWithForcedFlush("Connectivity", true, "Connectivity DONE")

	// Create test groups based on requested subgroups
	testGroups := buildL3TestGroups(requestedSubgroups)

	// Execute test groups sequentially with timing collection
	timedResults, _ := executeL3TestGroupsWithTiming(t, ctx, testGroups, isVerbose)

	// Extract basic results for backward compatibility
	for _, timedResult := range timedResults {
		allResults = append(allResults, timedResult.TestResult)
	}

	// Calculate the overall execution time
	overallElapsed := ElapsedSeconds(overallStart)

	// Calculate passed/failed counts for final summary
	passedTests := 0
	failedTests := 0
	for _, result := range allResults {
		if result.Success {
			passedTests++
		} else {
			failedTests++
		}
	}

	// Create display names mapping for L3 tests
	displayNames := map[string]string{
		"cidr-ingress":       "CIDR Ingress Policy",
		"cidr-egress":        "CIDR Egress Policy",
		"cidr-except":        "CIDR With Except Policy",
		"endpoints-label":    "Endpoints Label Policy",
		"entities-based":     "Entities Based Policy",
		"dns-based":          "DNS Based Policy",
		"node-selector":      "Traditional Node Selector Policy",
		"pod-node-name":      "Pod Node Name Policy",
		"node-cidr":          "Node CIDR Policy",
		"node-based":         "Node Based Policy",
		"kubernetes-service": "Kubernetes Service Policy",
	}

	// Create test names list from the timed results
	var testNames []string
	for _, group := range testGroups {
		for _, testName := range group.TestNames {
			testNames = append(testNames, testName)
		}
	}

	// Display enhanced verbose summary with Expected vs Received details
	core.FormatEnhancedTestSummary(timedResults, testNames, displayNames, isVerbose)

	// Log final L3 summary with forced flush
	logger.GetFrontendLogger().LogL3SubgroupSummary("SUMMARY", passedTests, failedTests, overallElapsed, &core.HierarchyContext{
		GroupId: "l3-policies",
		Phase:   "summary",
	})

	return allResults
}

// buildL3TestGroups creates test groups based on requested subgroups
func buildL3TestGroups(requestedSubgroups []string) []L3TestGroup {
	groups := []L3TestGroup{}

	// If no specific subgroups are requested, use all available subgroups
	if len(requestedSubgroups) == 0 {
		for subgroup := range L3PolicySubgroups {
			requestedSubgroups = append(requestedSubgroups, subgroup)
		}
	}

	// Map each test key to its function with updated signature
	testFunctions := map[string]func(*core.MultiChannelLogger, *core.Tester, context.Context, bool, bool, int, int) TestResult{
		"cidr-ingress":       TestCIDRIngressPolicy,
		"cidr-egress":        TestCIDREgressPolicy,
		"cidr-except":        TestCIDRWithExceptPolicy,
		"endpoints-label":    TestEndpointsLabelPolicy,
		"entities-based":     TestEntitiesBasedPolicy,
		"dns-based":          TestDNSBasedPolicy,
		"node-selector":      TestTraditionalNodeSelectorPolicy,
		"pod-node-name":      TestPodNodeNamePolicy,
		"node-cidr":          TestNodeCIDRPolicy,
		"node-based":         TestNodeBasedPolicy,
		"kubernetes-service": TestKubernetesServicePolicy,
	}

	// Build groups based on requested subgroups
	for _, subgroupName := range requestedSubgroups {
		testNames, exists := L3PolicySubgroups[subgroupName]
		if !exists {
			fmt.Printf("Warning: Subgroup '%s' not found in L3 policies, skipping\n", subgroupName)
			continue
		}

		group := L3TestGroup{
			Name:      subgroupName,
			TestFuncs: []func(*core.MultiChannelLogger, *core.Tester, context.Context, bool, bool, int, int) TestResult{},
			TestNames: []string{},
		}

		// Add tests to the group
		for _, testName := range testNames {
			testFunc, exists := testFunctions[testName]
			if exists {
				group.TestFuncs = append(group.TestFuncs, testFunc)
				group.TestNames = append(group.TestNames, testName)
			} else {
				fmt.Printf("Warning: Test function for '%s' not found, skipping\n", testName)
			}
		}

		if len(group.TestFuncs) > 0 {
			groups = append(groups, group)
		}
	}

	return groups
}

// executeL3TestGroups runs the test groups with sequential execution for clean policy isolation
func executeL3TestGroups(t *core.Tester, ctx context.Context, groups []L3TestGroup, verbose bool) []TestResult {
	var allResults []TestResult

	// PHASE 5: Use command logger singleton instead of creating new instance
	logger := core.GetGlobalMultiChannelLogger()
	if logger == nil {
		fmt.Printf("ERROR: Failed to get global multi-channel logger\n")
		return allResults
	}

	// Create cleanup orchestrator
	orchestrator := core.NewCleanupOrchestrator(t, logger)

	// Calculate total number of tests for sequential numbering
	totalTests := 0
	for _, group := range groups {
		totalTests += len(group.TestFuncs)
	}

	currentTestNumber := 1

	// Execute subgroups sequentially to maintain clean output formatting and avoid policy conflicts
	for i, group := range groups {
		// Track execution time for this group
		groupStart := time.Now()

		// Print subgroup header
		fmt.Printf("\n=== L3 SUBGROUP: %s (%d/%d) ===\n", strings.ToUpper(group.Name), i+1, len(groups))

		// Create group-specific context with timeout
		groupCtx, cancel := context.WithTimeout(ctx, 10*time.Minute)
		defer cancel()

		// Execute tests within this group
		var groupResults []TestResult

		// Run tests in this group sequentially for proper output formatting
		for j, testFunc := range group.TestFuncs {
			testName := group.TestNames[j]

			// Track test execution time
			testStart := time.Now()

			// Print test start
			fmt.Printf("\n--- Test %d/%d: %s ---\n", j+1, len(group.TestFuncs), testName)

			// Execute the test with complete isolation and structured logging
			result := testFunc(logger, t, groupCtx, false, verbose, currentTestNumber, totalTests)
			testElapsed := ElapsedSeconds(testStart)
			currentTestNumber++

			// Print test completion with timing
			if result.Success {
				fmt.Printf("✅ %s PASSED in %.1fs\n", testName, testElapsed)
			} else {
				fmt.Printf("❌ %s FAILED in %.1fs\n", testName, testElapsed)
			}

			// Enhance result with subgroup and test name information
			enhancedMessage := fmt.Sprintf("[%s] %s: %s",
				strings.ToUpper(group.Name),
				testName,
				result.Message)
			result.Message = enhancedMessage

			groupResults = append(groupResults, result)

			// Emergency cleanup if test failed
			if !result.Success {
				orchestrator.EmergencyCleanup(groupCtx, fmt.Sprintf("Test %s failed", testName))
			}

			// SMART DELAY: Add longer cooling period between tests for complete isolation
			// This prevents API rate limiting and ensures clean state between tests
			if j < len(group.TestFuncs)-1 { // Don't delay after the last test in group
				fmt.Printf("%s Adding smart delay between tests for API rate limiting mitigation...\n",
					time.Now().Format("2006-01-02 15:04:05"))
				time.Sleep(5 * time.Second)
			}
		}

		// Record group completion
		groupEnd := time.Now()
		elapsedTime := groupEnd.Sub(groupStart)

		// Calculate passed tests for this group
		passedCount := 0
		for _, result := range groupResults {
			if result.Success {
				passedCount++
			}
		}

		// Print enhanced mini summary for this subgroup
		fmt.Printf("\n=== %s SUBGROUP COMPLETE ===\n", strings.ToUpper(group.Name))
		for k, result := range groupResults {
			testName := group.TestNames[k]
			if result.Success {
				fmt.Printf("✅ %s: PASSED (0.0s) - %s\n", testName, result.Message)
			} else {
				fmt.Printf("❌ %s: FAILED (0.0s) - %s\n", testName, result.Message)
			}
		}
		fmt.Printf("📊 %s Summary: %d passed, %d failed (%.1fs total)\n",
			strings.ToUpper(group.Name), passedCount, len(groupResults)-passedCount, elapsedTime.Seconds())

		// Add test results to overall results list
		for _, res := range groupResults {
			allResults = append(allResults, res)
		}

		// Cooling period between groups
		time.Sleep(3 * time.Second)
	}

	return allResults
}

// executeL3TestGroupsWithTiming runs the test groups with optimized cleanup like L4
func executeL3TestGroupsWithTiming(t *core.Tester, ctx context.Context, groups []L3TestGroup, verbose bool) ([]core.TimedTestResult, []string) {
	var timedResults []core.TimedTestResult
	var testNames []string

	// Use command logger singleton for JSONL logging
	logger := core.GetGlobalMultiChannelLogger()
	if logger == nil {
		fmt.Printf("ERROR: Failed to get global multi-channel logger\n")
		return timedResults, testNames
	}

	// Create cleanup orchestrator for optimized resource management
	orchestrator := core.NewCleanupOrchestrator(t, logger)

	// Clean hierarchical output header
	fmt.Println("\n🧪 TESTING PHASE")

	// Calculate total number of tests
	totalTests := 0
	for _, group := range groups {
		totalTests += len(group.TestFuncs)
	}

	currentTestNumber := 1

	// Execute subgroups with clean tree structure and optimized cleanup
	for i, group := range groups {
		// Determine tree connector
		groupConnector := "├──"
		if i == len(groups)-1 {
			groupConnector = "└──"
		}

		// Print subgroup header
		fmt.Printf("%s L3 Subgroup: %s (%d tests)\n", groupConnector, strings.ToUpper(group.Name), len(group.TestFuncs))

		// Create group-specific context with timeout
		groupCtx, cancel := context.WithTimeout(ctx, 10*time.Minute)
		defer cancel()

		// Run tests in this group with optimized cleanup
		for j, testFunc := range group.TestFuncs {
			testName := group.TestNames[j]

			// OPTIMIZED: Only cleanup policies between tests (reuse pods for speed)
			orchestrator.OptimizedPreTestCleanup(groupCtx, testName)

			// Determine test tree connector
			testConnector := "│   ├──"
			if i == len(groups)-1 {
				testConnector = "    ├──"
			}
			if j == len(group.TestFuncs)-1 {
				if i == len(groups)-1 {
					testConnector = "    └──"
				} else {
					testConnector = "│   └──"
				}
			}

			// Print test start (without newline)
			fmt.Printf("%s %s: Testing policies... ", testConnector, testName)

			// Track test execution time
			testStart := time.Now()

			// Execute the test with pod reuse for faster execution
			result := testFunc(logger, t, groupCtx, false, verbose, currentTestNumber, totalTests)
			testEnd := time.Now()
			testElapsed := ElapsedSeconds(testStart)
			currentTestNumber++

			// Emergency cleanup if test failed
			if !result.Success {
				orchestrator.EmergencyCleanup(groupCtx, fmt.Sprintf("Test %s failed", testName))
			}

			// Capture REAL connectivity data during L3 policy tests instead of using fake data
			var connectivityResults []core.ConnectivityResult

			// Use real data capture (replacing fake data implementation)
			connectivityResults = t.CaptureRealL3ConnectivityData(groupCtx, testName)

			// If no real results captured, show empty results rather than fake data
			// This maintains transparency about what actually happened during the test
			if len(connectivityResults) == 0 {
				connectivityResults = []core.ConnectivityResult{} // Empty - no fake data
			}

			// Create enhanced test result with real connectivity data (or empty if none captured)
			enhancedResult := core.CreateEnhancedTestResultWithExpectation(result, testName+"-policy", connectivityResults, nil)

			// Use enhanced formatting for hierarchical display
			formattedResult := core.FormatEnhancedTestResultForHierarchy(testName, enhancedResult, testElapsed, verbose)

			// Print the formatted result (it includes the inline timing)
			fmt.Print(formattedResult)

			// Add visual separator line after every test completion
			fmt.Println("────────────────────────────────────────────────────────")

			// Create TimedTestResult
			timedResult := core.TimedTestResult{
				TestResult: result,
				StartTime:  testStart,
				EndTime:    testEnd,
			}

			// Store results
			timedResults = append(timedResults, timedResult)
			testNames = append(testNames, testName)

			// Still log to JSONL for tracking
			hierarchy := &core.HierarchyContext{
				GroupId:    "l3-policies",
				SubgroupId: group.Name,
				TestId:     testName,
				Phase:      "execution",
			}
			logger.GetFrontendLogger().LogL3TestComplete(testName, group.Name, currentTestNumber-1, totalTests, result.Success, testElapsed, hierarchy)

			// OPTIMIZED DELAY: Reduced delay since we're reusing pods
			if j < len(group.TestFuncs)-1 { // Don't delay after the last test in group
				fmt.Printf("%s Policy cleanup pause for API rate limiting...\n",
					time.Now().Format("2006-01-02 15:04:05"))
				time.Sleep(2 * time.Second) // Reduced from 10s since we're only cleaning policies
			}
		}

		// OPTIMIZED: Post-subgroup cleanup (clean pods between subgroups for isolation)
		orchestrator.OptimizedPostSubgroupCleanup(ctx, group.Name)

		// OPTIMIZED: Reduced cooling period between groups
		if i < len(groups)-1 {
			time.Sleep(1 * time.Second) // Reduced from 15s
		}
	}

	return timedResults, testNames
}

// verifyLogFilesComplete verifies that all log files are written and complete
func verifyLogFilesComplete(logger *core.MultiChannelLogger) error {
	// Check verbose log file
	verboseLogPath := logger.GetSharedTimestamp().GetLogFilePath()
	if _, err := os.Stat(verboseLogPath); os.IsNotExist(err) {
		return fmt.Errorf("verbose log file not created: %s", verboseLogPath)
	}

	// Check frontend JSON Lines file
	frontendLogPath := logger.GetSharedTimestamp().GetFrontendLogFilePath()
	if _, err := os.Stat(frontendLogPath); os.IsNotExist(err) {
		return fmt.Errorf("frontend log file not created: %s", frontendLogPath)
	}

	return nil
}

// TestL3Policies runs all L3 policy tests
func TestL3Policies(t *core.Tester, ctx context.Context, verbose bool) []TestResult {
	allResults := []TestResult{}

	if verbose {
		fmt.Printf("\n===== L3 POLICIES ENHANCED EXECUTION - VERBOSE MODE ENABLED =====\n")
		fmt.Printf("Verbose output will be shown for each test\n")
		fmt.Printf("============================================================\n\n")
	}

	// Record overall start time
	overallStart := time.Now()

	// Define subgroups to run
	subgroups := []string{"ip-cidr", "endpoint", "entities", "dns", "node", "service"}

	// Create test groups based on subgroups
	testGroups := buildL3TestGroups(subgroups)

	// Execute test groups sequentially
	allResults = executeL3TestGroups(t, ctx, testGroups, verbose)

	// Calculate the overall execution time
	overallElapsed := ElapsedSeconds(overallStart)

	// Final cleanup
	fmt.Printf("%s Performing final cleanup...\n", time.Now().Format("2006-01-02 15:04:05"))
	t.CleanupAllTestResources(ctx, false)

	// Print the overall summary
	fmt.Printf("\n=== L3 POLICIES TEST SUMMARY ===\n")

	// Calculate passed/failed counts
	passedTests := 0
	failedTests := 0
	for _, result := range allResults {
		if result.Success {
			passedTests++
		} else {
			failedTests++
		}
	}

	// Print overall statistics
	fmt.Printf("Overall: %d passed, %d failed\n", passedTests, failedTests)

	// Print per-group statistics
	groupStats := make(map[string][]TestResult)
	for _, result := range allResults {
		// Extract group name from enhanced message format: [GROUP] test: message
		parts := strings.Split(result.Message, "]")
		if len(parts) > 0 {
			groupName := strings.TrimPrefix(parts[0], "[")
			groupName = strings.ToLower(groupName)
			groupStats[groupName] = append(groupStats[groupName], result)
		}
	}

	for groupName, results := range groupStats {
		passedCount := 0
		for _, result := range results {
			if result.Success {
				passedCount++
			}
		}
		fmt.Printf("%s: %d passed, %d total\n", groupName, passedCount, len(results))
	}

	// Print total execution time
	fmt.Printf("Total execution time: %.1fs\n", overallElapsed)

	return allResults
}
