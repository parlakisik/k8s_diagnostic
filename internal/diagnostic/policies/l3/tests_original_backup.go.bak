package l3

import (
	"context"
	"fmt"
	"os"
	"strings"
	"time"

	"k8s-diagnostic/internal/diagnostic/core"

	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
)

// Type aliases for compatibility
type TestResult = core.TestResult

// Function aliases
var ElapsedSeconds = core.ElapsedSeconds

// L3PolicySubgroups defines test subgroups for organization and concurrent execution
// Exported so it can be accessed from cmd/test.go for validation
var L3PolicySubgroups = map[string][]string{
	"ip-cidr":  {"cidr-ingress", "cidr-egress", "cidr-except"},
	"endpoint": {"endpoints-label"},
	"entities": {"entities-based"},
	"dns":      {"dns-based"},
	"node":     {"node-selector", "pod-node-name", "node-cidr", "node-based"},
	"service":  {"kubernetes-service"},
}

// Map of test names to test keys (for CLI reference)
var L3PolicyTestNameToKey = map[string]string{
	"cidr-ingress":              "cidr-ingress",
	"cidr-egress":               "cidr-egress",
	"cidr-with-except":          "cidr-except",
	"endpoints-label":           "endpoints-label",
	"entities-based":            "entities-based",
	"dns-based":                 "dns-based",
	"traditional-node-selector": "node-selector",
	"pod-node-name":             "pod-node-name",
	"node-cidr":                 "node-cidr",
	"node-based":                "node-based",
	"kubernetes-service":        "kubernetes-service",
}

// TestCIDRIngressPolicy tests the CIDR-based ingress policy
func TestCIDRIngressPolicy(logger *core.MultiChannelLogger, t *core.Tester, ctx context.Context, reuseResources bool, verbose bool, testNumber int, totalTests int) TestResult {
	startTime := time.Now()
	var details []string

	policyName := "cidr-ingress-policy"
	policyPath := "cilium-policies/7-l3-policies/cidr-policies/cidr-ingress-policy.yaml"

	// Create a completely fresh context instead of inheriting from potentially exhausted parent
	freshCtx := context.Background()
	testCtx, cancel := context.WithTimeout(freshCtx, 3*time.Minute)
	defer cancel()

	// Ensure policy cleanup after test completion - use fresh context for cleanup too
	defer func() {
		cleanupCtx, cleanupCancel := context.WithTimeout(context.Background(), 30*time.Second)
		defer cleanupCancel()
		if err := t.CleanupNetworkPolicy(cleanupCtx, policyName, policyPath); err != nil {
			logger.LogError("Failed to cleanup policy %s: %v", policyName, err)
		}
	}()

	// Start test with structured logging (suppress verbose headers in hierarchical mode)
	if verbose {
		logger.LogTestStart("CIDR Ingress Policy Test", testNumber, totalTests, "l3-policies")
	}

	// Policy deployment - visible in both verbose and non-verbose modes (no step numbers)
	logger.LogStepName("Deploying CIDR ingress policy", "Policy file: cidr-ingress-policy.yaml")

	result := t.TestNetworkPolicy(
		testCtx,
		policyName,
		policyPath,
		true, // Expect connectivity to succeed after policy application - policy allows traffic from client pods and specified CIDR
		&details,
		verbose,
		reuseResources,
	)

	// Calculate test duration for verbose reporting
	duration := time.Since(startTime)

	if result.Success {
		logger.GetFrontendLogger().LogStepCompleteWithForcedFlush("Deploying CIDR ingress policy", true, "CIDR ingress policy deployed and tested successfully")
	} else {
		// Enhanced verbose mode: Show detailed failure information using ACTUAL command history
		if verbose {
			// Get the REAL command executor used during TestNetworkPolicy
			executor := t.GetLastExecutor()
			if executor != nil {
				failurePoint := "ICMP connectivity test"
				errorDetails := core.ExtractErrorDetailsFromCommand(executor.GetCommandHistory(), "L3 CIDR policy validation")

				enhancedResult := core.CreateEnhancedTestResult(result, executor, failurePoint, errorDetails)
				verboseOutput := core.FormatVerboseTestResultForHierarchy("cidr-ingress", enhancedResult, duration.Seconds(), verbose)

				logger.GetFrontendLogger().LogStepCompleteWithForcedFlush("Deploying CIDR ingress policy", false, verboseOutput)
			} else {
				logger.GetFrontendLogger().LogStepCompleteWithForcedFlush("Deploying CIDR ingress policy", false, result.Message)
			}
		} else {
			logger.GetFrontendLogger().LogStepCompleteWithForcedFlush("Deploying CIDR ingress policy", false, result.Message)
		}
	}

	// Complete test with logging and forced flush
	duration = time.Since(startTime)
	hierarchy := &core.HierarchyContext{
		GroupId:    "l3-policies",
		SubgroupId: "ip-cidr",
		TestId:     "cidr-ingress",
		Phase:      "execution",
	}
	logger.GetFrontendLogger().LogL3TestComplete("cidr-ingress", "ip-cidr", testNumber, totalTests, result.Success, duration.Seconds(), hierarchy)

	return result
}

// TestCIDREgressPolicy tests the CIDR-based egress policy
func TestCIDREgressPolicy(logger *core.MultiChannelLogger, t *core.Tester, ctx context.Context, reuseResources bool, verbose bool, testNumber int, totalTests int) TestResult {
	startTime := time.Now()
	var details []string

	policyName := "cidr-egress-policy"
	policyPath := "cilium-policies/7-l3-policies/cidr-policies/cidr-egress-policy.yaml"

	// Create a completely fresh context instead of inheriting from potentially exhausted parent
	freshCtx := context.Background()
	testCtx, cancel := context.WithTimeout(freshCtx, 3*time.Minute)
	defer cancel()

	// Ensure policy cleanup after test completion - use fresh context for cleanup too
	defer func() {
		cleanupCtx, cleanupCancel := context.WithTimeout(context.Background(), 30*time.Second)
		defer cleanupCancel()
		if err := t.CleanupNetworkPolicy(cleanupCtx, policyName, policyPath); err != nil {
			logger.LogError("Failed to cleanup policy %s: %v", policyName, err)
		}
	}()

	// Start test with structured logging (suppress verbose headers in hierarchical mode)
	if verbose {
		logger.LogTestStart("CIDR Egress Policy Test", testNumber, totalTests, "l3-policies")
	}

	// Policy deployment - visible in both verbose and non-verbose modes (no step numbers)
	logger.LogStepName("Deploying CIDR egress policy", "Policy file: cidr-egress-policy.yaml")

	result := t.TestNetworkPolicy(
		testCtx, // Use fresh timeout context
		policyName,
		policyPath,
		true, // Expect connectivity to succeed - policy allows traffic to API pod and specified CIDR
		&details,
		verbose,
		reuseResources,
	)

	if result.Success {
		logger.GetFrontendLogger().LogStepCompleteWithForcedFlush("Deploying CIDR egress policy", true, "CIDR egress policy deployed and tested successfully")
	} else {
		logger.GetFrontendLogger().LogStepCompleteWithForcedFlush("Deploying CIDR egress policy", false, result.Message)
	}

	// Complete test with logging and forced flush
	duration := time.Since(startTime)
	hierarchy := &core.HierarchyContext{
		GroupId:    "l3-policies",
		SubgroupId: "ip-cidr",
		TestId:     "cidr-egress",
		Phase:      "execution",
	}
	logger.GetFrontendLogger().LogL3TestComplete("cidr-egress", "ip-cidr", testNumber, totalTests, result.Success, duration.Seconds(), hierarchy)

	return result
}

